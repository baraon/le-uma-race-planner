# Copy this file to .env and fill it in. Never commit .env — this repo is public.

# --- Database (used by docker compose) ---
POSTGRES_USER=lmu
POSTGRES_PASSWORD=lmu-dev-password
POSTGRES_DB=lmu

# --- App ---
# Public URL people open in the browser. In dev that's the Vite server.
APP_URL=http://localhost:5173
# Long random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# --- Discord login (needed from Phase 1) ---
# Create an application at https://discord.com/developers/applications
# OAuth2 scope requested: identify (nothing else, no bot).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional; defaults to APP_URL + /auth/discord/callback. Must be registered in Discord.
DISCORD_REDIRECT_URI=http://localhost:5173/auth/discord/callback

# --- Production only ---
# The domain(s) Caddy serves (gets HTTPS automatically); www redirects to the bare domain.
# ":80" = plain HTTP (no domain yet). Production: SITE_ADDRESS="leumaplanner.com, www.leumaplanner.com"
SITE_ADDRESS=:80
